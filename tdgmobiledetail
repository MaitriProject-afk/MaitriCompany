<script>
  (function() {
    // Discord Share Micro-toast
    const discordBtn = document.getElementById('discordShareBtn');
    if (discordBtn) {
      discordBtn.addEventListener('click', function() {
        const originalText = discordBtn.innerHTML;
        discordBtn.innerHTML = '<span class="material-symbols-outlined text-sm">check</span><span class="font-label-sm text-label-sm font-bold tracking-wider">TERSALIN</span>';
        if (navigator.clipboard) {
          navigator.clipboard.writeText(window.location.href);
        }
        setTimeout(() => {
          discordBtn.innerHTML = originalText;
        }, 2000);
      });
    }

    // Comment submission simulation
    const submitBtn = document.getElementById('submitCommentBtn');
    const inputName = document.getElementById('inputName');
    const inputOrigin = document.getElementById('inputOrigin');
    const inputText = document.getElementById('inputText');
    const feedback = document.getElementById('formFeedback');
    const stream = document.getElementById('commentStream');

    if (submitBtn && stream) {
      submitBtn.addEventListener('click', function() {
        const nameVal = inputName.value.trim() || 'Anon_Citizen';
        const originVal = inputOrigin.value.trim() || 'San Andreas';
        const textVal = inputText.value.trim();

        if (!textVal) {
          inputText.focus();
          return;
        }

        const newComment = document.createElement('div');
        newComment.className = 'bg-surface-container p-3 flex flex-col gap-1.5 animate-pulse';
        newComment.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="font-label-md text-label-md text-primary font-bold">${nameVal}</span>
            <span class="font-label-sm text-label-sm text-outline">Baru saja &bull; ${originVal}</span>
          </div>
          <p class="font-body-sm text-body-sm text-on-surface">${textVal}</p>
        `;

        stream.prepend(newComment);
        setTimeout(() => newComment.classList.remove('animate-pulse'), 1000);

        inputText.value = '';
        inputName.value = '';
        inputOrigin.value = '';

        if (feedback) {
          feedback.classList.remove('opacity-0');
          setTimeout(() => {
            feedback.classList.add('opacity-0');
          }, 3000);
        }
      });
    }

    // Confidential Tip micro-prompt
    const tipBtn = document.getElementById('tipModalBtn');
    if (tipBtn) {
      tipBtn.addEventListener('click', function() {
        const promptCode = prompt("Masukkan sandi enkripsi atau deskripsi petunjuk investigasi rahasia:");
        if (promptCode) {
          alert("Petunjuk berhasil dienkripsi dan dikirim ke loker redaktur The Daily Globes. Terima kasih atas kontribusi Anda.");
        }
      });
    }
  })();
