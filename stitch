<script>
    let currentRole = 'mitra';

    function switchRole(role) {
      currentRole = role;
      const tabMitra = document.getElementById('tabMitra');
      const tabKlien = document.getElementById('tabKlien');
      const roleNotice = document.getElementById('roleNotice');
      const roleIcon = document.getElementById('roleIcon');
      const roleText = document.getElementById('roleText');
      const identifierInput = document.getElementById('identifier');
      const labelIdentifier = document.getElementById('labelIdentifier');
      const labelPassword = document.getElementById('labelPassword');

      if (role === 'mitra') {
        // Active Mitra Tab
        tabMitra.className = "flex items-center justify-center gap-space-xs py-2.5 px-space-sm rounded font-label-lg text-label-lg transition-all shadow-sm bg-surface-container-lowest text-primary";
        tabKlien.className = "flex items-center justify-center gap-space-xs py-2.5 px-space-sm rounded font-label-lg text-label-lg transition-all text-secondary hover:text-on-surface";
        
        roleIcon.innerText = "local_shipping";
        roleText.innerText = "Akses pengemudi, armada vendor, dan pengelola gudang Maitri Logistik.";
        labelIdentifier.innerText = "Nomor Ponsel Pengemudi / ID Mitra";
        identifierInput.placeholder = "Contoh: 08123456789 atau ML-9842";
        labelPassword.innerText = "PIN Operasional / Kata Sandi";
      } else {
        // Active Klien Tab
        tabKlien.className = "flex items-center justify-center gap-space-xs py-2.5 px-space-sm rounded font-label-lg text-label-lg transition-all shadow-sm bg-surface-container-lowest text-primary";
        tabMitra.className = "flex items-center justify-center gap-space-xs py-2.5 px-space-sm rounded font-label-lg text-label-lg transition-all text-secondary hover:text-on-surface";
        
        roleIcon.innerText = "corporate_fare";
        roleText.innerText = "Portal khusus klien interior, pimpinan proyek, dan arsitek penanggung jawab.";
        labelIdentifier.innerText = "Email Korporat / ID Proyek";
        identifierInput.placeholder = "Contoh: budi@ptcipta.com atau PRJ-2024-JKT";
        labelPassword.innerText = "Kata Sandi Akun Proyek";
      }
    }

    function togglePasswordVisibility() {
      const passwordField = document.getElementById('passwordField');
      const eyeIcon = document.getElementById('eyeIcon');
      
      if (passwordField.type === 'password') {
        passwordField.type = 'text';
        eyeIcon.innerText = 'visibility_off';
      } else {
        passwordField.type = 'password';
        eyeIcon.innerText = 'visibility';
      }
    }

    function simulateLogin() {
      const submitBtn = document.getElementById('submitBtn');
      const originalHTML = submitBtn.innerHTML;
      
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <span class="w-4 h-4 border-2 border-on-primary border-t-transparent rounded-full animate-spin"></span>
        <span>Memverifikasi Akses...</span>
      `;

      setTimeout(() => {
        submitBtn.innerHTML = `
          <span class="material-symbols-outlined text-[18px]">check_circle</span>
          <span>Berhasil Masuk</span>
        `;
        submitBtn.classList.remove('bg-primary-container');
        submitBtn.classList.add('bg-[#15803d]');

        setTimeout(() => {
          submitBtn.innerHTML = originalHTML;
          submitBtn.disabled = false;
          submitBtn.classList.add('bg-primary-container');
          submitBtn.classList.remove('bg-[#15803d]');
          alert("Otentikasi " + (currentRole === 'mitra' ? "Mitra Logistik" : "Klien Desain") + " Terverifikasi. Mengarahkan ke Dashboard Operasional Maitri...");
        }, 1200);
